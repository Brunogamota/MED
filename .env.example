# ---------------------------------------------------------------------------
# MED Defense — environment variables
# Copy to .env.local for development. NEVER commit real secrets.
# Every variable below is documented; the app fails fast with a clear message
# when a required one is missing (see src/lib/env.ts).
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
# development | preview | production
# On Vercel this is provided automatically as VERCEL_ENV; locally set APP_ENV.
APP_ENV=development

# Public base URL of the deployment. Used for absolute links in documents.
# On Vercel, VERCEL_URL is used automatically when this is unset.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Hosts extras autorizados a chamar Server Actions (POST dos formularios),
# separados por virgula. Necessario apenas quando voce acessa o app por um host
# que o servidor nao enxerga (URL encaminhada do VS Code, proxy, tunel, preview)
# e que nao esta na lista de provedores conhecidos do next.config.ts. Sem isso,
# gerar comprovante/documento falha com "Invalid Server Actions request".
# Ex.: APP_ALLOWED_ORIGINS=meu-tunel.exemplo.dev,outro-host.com
# APP_ALLOWED_ORIGINS=

# --- Persistence -----------------------------------------------------------
# PostgreSQL connection string (pooled connection for serverless).
# When UNSET the app runs in DEMO mode with an in-memory repository:
#   - no data is persisted
#   - data does not survive a serverless cold start / is per-instance
# Demo mode is intentional so preview deploys work before a DB is provisioned.
# Production MUST set this.
# DATABASE_URL="postgresql://user:password@host:5432/med?sslmode=require&pgbouncer=true"

# Direct (non-pooled) connection, required by `prisma migrate`.
# DIRECT_DATABASE_URL="postgresql://user:password@host:5432/med?sslmode=require"

# --- Login do console ------------------------------------------------------
# Quando as DUAS variaveis abaixo existem, o console passa a exigir login:
# o middleware redireciona para /login qualquer rota sem sessao valida.
# Faltando qualquer uma delas o login nao existe e o console fica aberto —
# o mesmo comportamento de antes, e a tela de login avisa isso na cara.
#
# Gere as duas de uma vez:
#   node scripts/hash-password.mjs 'sua senha'
#
# ADMIN_PASSWORD_HASH=scrypt:<salt hex>:<hash hex>
# SESSION_SECRET=<32 bytes em hex>   # assina o cookie de sessao

# --- Auth / tenancy --------------------------------------------------------
# Comma-separated API keys for machine-to-machine access, in the form
#   <key>:<organization_id>:<role>
# role is one of: OWNER, ANALYST, VIEWER
# Example (development only — generate real random keys per environment):
# API_KEYS="dev_key_change_me:org_demo:OWNER"

# Secret used to sign document download URLs (signed URLs).
# Generate with: openssl rand -hex 32
# DOCUMENT_URL_SIGNING_SECRET=

# Shared secret used to validate inbound MED webhooks (HMAC-SHA256).
# WEBHOOK_SIGNING_SECRET=

# --- Object storage (S3-compatible) ---------------------------------------
# Not required for the MVP: when unset, documents are stored via the
# in-process storage adapter (ephemeral). Prepared, not yet wired to a bucket.
# S3_ENDPOINT=
# S3_REGION=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --- LLM (optional) --------------------------------------------------------
# The LLM only rewrites an already-built Defense JSON into prose and its output
# is fact-guarded (src/domain/llm/guard.ts). When unset, the deterministic
# template renderer is used and the product remains fully functional.
# ANTHROPIC_API_KEY=
# LLM_MODEL=claude-sonnet-5

# --- External providers (adapters prepared, not implemented) ---------------
# Tracking / logistics
# CORREIOS_API_TOKEN=
# MELHORENVIO_API_TOKEN=
# Commerce
# SHOPIFY_API_TOKEN=
# Payments
# PAGARME_API_TOKEN=
